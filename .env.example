# Zapp Studios site — environment contract.
# Copy to .env.local and fill in. .env* is gitignored, so nothing here leaks.

# ── /fit onboarding funnel ────────────────────────────────────────────
# Supabase project "zapp-studios" (ghgwsvgxlcxghppzjkrb). Service role — it
# bypasses RLS entirely, every write is server-side, and there is deliberately
# no NEXT_PUBLIC_ variant of THESE two. See the CRM block below for the key
# that is safe in a browser; the two are not interchangeable.
SUPABASE_URL=https://ghgwsvgxlcxghppzjkrb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── CRM sign-in (/login, /admin) ──────────────────────────────────────
# Same Supabase project, opposite kind of key, and the difference matters:
#
#   SUPABASE_SERVICE_ROLE_KEY  bypasses RLS. Trusted absolutely. Server only.
#   NEXT_PUBLIC_SUPABASE_...   carries no authority of its own. It acts as
#                              whoever is signed in, and RLS decides the rest.
#
# The publishable key is MEANT to ship in the client bundle — that is what the
# NEXT_PUBLIC_ prefix does. On its own it reaches nothing: every CRM table is
# deny-all except `crm_admins`, whose only policy is self-read, so a signed-in
# stranger gets an empty result rather than the allow-list.
#
# Legacy anon keys and new sb_publishable_ keys both work on this project. The
# newer name wins if both are set.
NEXT_PUBLIC_SUPABASE_URL=https://ghgwsvgxlcxghppzjkrb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=      # legacy fallback, only read if the above is unset

# Lead notification. Until the sending domain is verified in Resend, use
# onboarding@resend.dev as the from address.
RESEND_API_KEY=
LEAD_NOTIFY_TO=hamzazulquernain1@gmail.com
LEAD_NOTIFY_FROM=Zapp Studios <onboarding@resend.dev>

# Any 32+ random characters. Rotating it resets rate-limit buckets.
IP_HASH_SALT=

# ── Password-gated client documents ───────────────────────────────────
DISPO_PASSWORD=
PLATR_PASSWORD=
HOUSTON_ZIPS_PASSWORD=
INVESTOR_DECK_PASSWORD=

# ── Vercel Blob (houston-zips selection, investor deck) ───────────────
BLOB_READ_WRITE_TOKEN=
